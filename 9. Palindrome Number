import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();  //121
        
        int org = num; //121
        int rev=0;
        while(num!=0){
            int rem = num%10;   //121%10 =1
            rev = rev*10+ rem;  //0*10+1=1
            num= num/10;        //121/10= 12
        }
        
        if(rev == org){
            System.out.print("Palindrome");
        }
    }
}
