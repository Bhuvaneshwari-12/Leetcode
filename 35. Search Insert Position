import java.util.*;
public class Main
{
	public static void main(String[] args) {
	      Scanner sc = new Scanner (System.in);
	      int nums = sc.nextInt();
	      int target = sc.nextInt();
	      int result= nums;
	      for(int i=0 ; i<nums; i++){
	          int num =  sc.nextInt();
	          if(num>= target){
	              result = i;
	              break;
	          }
	      }
	      System.out.print(result);
	   
	}
}
