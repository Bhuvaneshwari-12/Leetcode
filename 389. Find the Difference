import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String a = sc.nextLine(); //abcd
        String b = sc.nextLine(); //abcde
        int xor='\0';
        for(char c: a.toCharArray()){
            xor= xor^c;
        }
        for(char c: b.toCharArray()){
            xor= xor^c;
        }
        System.out.print((char)xor);
    }
}
