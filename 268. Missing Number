import java.util.*;
public class Main
{
	public static void main(String[] args) {
	      Scanner sc = new Scanner (System.in);
	      int nums = sc.nextInt();
	      int xor=0;
	      for(int i=0; i<nums;i++){
	          int num = sc.nextInt();
	          xor = xor^num;
	      }
	      for(int i=0; i<=nums;i++){
	          xor = xor^i;
	      }
	      System.out.print(xor);
	}
}
