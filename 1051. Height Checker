import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int s = sc.nextInt();
        int[] numhei = new int[s];

        // Input array
        for (int i = 0; i < s; i++) {
            numhei[i] = sc.nextInt();
        }

        // Copy array manually
        int[] exp = new int[s];
        for (int i = 0; i < s; i++) {
            exp[i] = numhei[i];
        }

        // Sort exp array using Bubble Sort
        for (int i = 0; i < s - 1; i++) {
            for (int j = 0; j < s - i - 1; j++) {
                if (exp[j] > exp[j + 1]) {
                    int temp = exp[j];
                    exp[j] = exp[j + 1];
                    exp[j + 1] = temp;
                }
            }
        }

        // Count mismatches
        int count = 0;
        for (int i = 0; i < s; i++) {
            if (numhei[i] != exp[i]) {
                count++;
            }
        }

        // Output
        System.out.println(count);
    }
}
